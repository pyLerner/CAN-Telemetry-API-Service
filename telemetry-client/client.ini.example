# Пример INI для telemetry-client (справочная копия).
# Боевой файл в репозитории: client.ini

[client]
api-server-host = 192.168.9.220
api-server-port = 7080
log-path = /usr/local/Bus/Services/PasCounter/recv/recv.txt
last-state-only = true
poll-interval-sec = 0.3
write-unknown-state = false
write-initial-state = true
# last-state-only = true  — в файле по одной строке на дверь (обновление на месте)
# last-state-only = false — каждое событие дописывается в конец файла
timeout = 60
timezone = local
